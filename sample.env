POSTGRES_DB=jobfinder
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder
DATABASE_URL=postgres://jobfinder:jobfinder@postgres:5432/jobfinder?sslmode=disable

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=events
RABBITMQ_QUEUE=resume-parser.queue

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=jobfinder
KAFKA_TOPIC_JOBS_SCRAPED=jobs.scraped.v1
KAFKA_TOPIC_JOBS_PROCESSED=jobs.processed.v1
KAFKA_TOPIC_RESUME_PARSED=resume.parsed.v1
KAFKA_TOPIC_MATCHES_GENERATED=matches.generated.v1
KAFKA_TOPIC_USER_INTERACTION=user.interaction.v1
KAFKA_TOPIC_USER_FEATURES_UPDATED=user.features.updated.v1
KAFKA_TOPIC_DLQ_PREFIX=dlq.

ENABLE_KAFKA_CONSUMERS=true
ENABLE_RABBITMQ_CONSUMERS=true
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
MIRROR_RABBITMQ_EVENTS=true

JOB_PROCESSOR_CONSUMER_GROUP=job-processor.v1
JOB_MATCHER_CONSUMER_GROUP=job-matcher.v1
SCHEDULER_CONSUMER_GROUP=scheduler.v1
FEATURE_AGGREGATOR_CONSUMER_GROUP=feature-aggregator.v1

REDIS_ADDR=redis:6379
CACHE_TTL=2m

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=resumes

MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=local-dev-master-key
MEILI_MASTER_KEY=local-dev-master-key

JWT_SECRET=super-secret-jwt
JWT_TTL=24h
INTERNAL_API_TOKEN=internal-secret

API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
RESUME_SERVICE_PORT=8082
RESUME_PARSER_PORT=8083
JOB_SCRAPER_PORT=8084
JOB_PROCESSOR_PORT=8085
JOB_MATCHER_PORT=8086
RECOMMENDATION_SERVICE_PORT=8087
SCHEDULER_PORT=8088
OUTBOX_RELAY_PORT=8091
FEATURE_AGGREGATOR_PORT=8092
FRONTEND_PORT=3000

USER_SERVICE_URL=http://user-service:8081
RESUME_SERVICE_URL=http://resume-service:8082
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8087
JOB_SCRAPER_URL=http://job-scraper:8084
JOB_MATCHER_URL=http://job-matcher:8086

NEXT_PUBLIC_API_BASE_URL=/api
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080

CRON_SCRAPE=*/30 * * * *
CRON_MATCH=15 * * * *
CRON_WEEKLY_EMAIL=0 9 * * 1

EMAIL_API_URL=https://email-sender-eight-pi.vercel.app/send-email
EMAIL_PASS1=pass@1
EMAIL_PASS2=pass@3
